MY_WA_JID=15551234567@s.whatsapp.net
GROUP_JID=123456789@g.us
# Set to true to log all incoming JIDs — use to discover GROUP_JID, then remove
DISCOVER_MODE=false
AGENT_URL=http://host.docker.internal:8788/message
# Word that must appear in a group message for the bridge to forward it
TRIGGER_WORD=@agent
PORT=8789

# Audio transcription. Any OpenAI-compatible /audio/transcriptions endpoint works
# (OpenAI, Groq, a local whisper.cpp server).
TRANSCRIPTION_URL=https://api.openai.com/v1/audio/transcriptions
TRANSCRIPTION_MODEL=whisper-1
TRANSCRIPTION_API_KEY=your_api_key_here
